# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATA_ENCRYPTION_SECRET: Server-side secret for AES-256-GCM encryption of sensitive taxpayer fields (PAN).
# Expected format: 64 lowercase/uppercase hex characters (32 random bytes / 256 bits), e.g. generated via:
#   openssl rand -hex 32
# IMPORTANT: Never set this to a Firebase Web API key (AIza...) and never prefix it with VITE_.
DATA_ENCRYPTION_SECRET="CHANGE_ME_64_HEX_CHAR_SECRET_FROM_OPENSSL_RAND_HEX_32"

# Firebase Authentication Emulator (LOCAL DEVELOPMENT ONLY)
# Set VITE_USE_FIREBASE_AUTH_EMULATOR="true" and FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# in .env.local when running `npm run emulators:auth`.
# Production builds (import.meta.env.PROD / NODE_ENV=production) strictly ignore these variables.
VITE_USE_FIREBASE_AUTH_EMULATOR="false"
VITE_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"
FIREBASE_AUTH_EMULATOR_HOST=""
